{
  "name": "@journeybook/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Journey Book web app — React + Vite + Tailwind shell (Stage 0).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@journeybook/atlas-core": "workspace:*",
    "@journeybook/ui": "workspace:*",
    "maplibre-gl": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
