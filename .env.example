# Copy to .env and adjust. Used by infra/compose/docker-compose.yml.

# Postgres / PostGIS
POSTGRES_USER=journeybook
# REQUIRED — compose refuses to start without it, and there is no default on
# purpose: a password shipped in a public template is a published credential,
# not a default. Generate one, e.g.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=journeybook
# Host publish port for Postgres. 5433 by default to avoid clashing with a
# locally installed Postgres on 5432. The api connects to db:5432 inside the
# compose network regardless.
DB_PORT=5433

# Host ports
API_PORT=5180
WEB_PORT=8080

# ASP.NET Core. Production by default: Development serves developer exception
# pages (stack traces, file paths, framework versions) to anything that can
# reach the port. Set Development only when you are debugging the API itself.
ASPNETCORE_ENVIRONMENT=Production

# --- Tile source registry + egress (SSRF containment) ----------------------
# The tile registry stores a URL the server then fetches and returns the body of,
# so its write endpoints are gated by a shared admin key. UNSET means the registry
# is read-only, which is the safe default -- set a key only if you need to add
# tile sources at runtime, and send it as the X-Admin-Key header.
#   openssl rand -base64 24
TileSources__AdminApiKey=

# Strongest setting: an explicit host allowlist for outbound tile fetches. When
# empty, the fetchers instead refuse private/loopback/link-local addresses (which
# is what stops http://169.254.169.254/ reaching your cloud metadata service).
# Comma-indexed, e.g. Tiles__AllowedHosts__0=basemap.nationalmap.gov
# Tiles__AllowedHosts__0=

# Re-enables fetching from private networks. Only for a tile server on localhost;
# it re-opens the SSRF the allowlist/deny-ranges exist to close.
Tiles__AllowPrivateNetworks=false
