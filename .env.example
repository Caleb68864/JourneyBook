# Copy to .env and adjust. Used by infra/compose/docker-compose.yml.

# Postgres / PostGIS
POSTGRES_USER=journeybook
# REQUIRED — compose refuses to start without it, and there is no default on
# purpose: a password shipped in a public template is a published credential,
# not a default. Generate one, e.g.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=journeybook
# Host publish port for Postgres. 5433 by default to avoid clashing with a
# locally installed Postgres on 5432. The api connects to db:5432 inside the
# compose network regardless.
DB_PORT=5433

# Host ports
API_PORT=5180
WEB_PORT=8080

# ASP.NET Core. Production by default: Development serves developer exception
# pages (stack traces, file paths, framework versions) to anything that can
# reach the port. Set Development only when you are debugging the API itself.
ASPNETCORE_ENVIRONMENT=Production
